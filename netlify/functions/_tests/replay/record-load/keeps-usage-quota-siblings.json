{
  "description": "Recording a load writes usageQuota back whole: fields beside `loads` survive, since Auth0 merges app_metadata one top-level key at a time (codex review on Share#1980).",
  "env": {
    "$fixture": "env/auth0.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/record-load",
    "headers": {
      "authorization": "Bearer user-access-token"
    },
    "body": {
      "key": "/share/v/g/replay-model"
    }
  },
  "exchanges": [
    {
      "$fixture": "exchanges/auth0-userinfo.json"
    },
    {
      "$fixture": "exchanges/auth0-mgmt-token.json"
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347"
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json",
          "$merge": {
            "app_metadata": {
              "usageQuota": {
                "loads": [],
                "note": "kept"
              }
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        },
        "body": {
          "app_metadata": {
            "usageQuota": {
              "note": "kept"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json"
        }
      }
    }
  ],
  "expect": {
    "statusCode": 200,
    "json": {
      "allowed": true,
      "used": 1,
      "tier": "free",
      "alreadyCounted": false
    }
  }
}
