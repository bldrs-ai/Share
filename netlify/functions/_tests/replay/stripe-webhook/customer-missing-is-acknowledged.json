{
  "description": "Stripe answering 404 resource_missing for the customer is permanent: acknowledge (200) so Stripe stops redelivering, and write nothing.",
  "env": {
    "$fixture": "env/stripe.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/stripe-webhook",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "user-agent": "Stripe/1.0 (+https://stripe.com/docs/webhooks)"
    },
    "sign": "stripe",
    "body": {
      "$fixture": "stripe/event.subscription.created.json"
    }
  },
  "exchanges": [
    {
      "$fixture": "exchanges/stripe-subscriptions-pro-active.json"
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.stripe.com/v1/customers/cus_Rreplay0001"
      },
      "response": {
        "status": 404,
        "json": {
          "error": {
            "code": "resource_missing",
            "message": "No such customer: 'cus_Rreplay0001'",
            "param": "id",
            "type": "invalid_request_error"
          }
        }
      }
    }
  ],
  "expect": {
    "statusCode": 200,
    "bodyIncludes": "not applied"
  }
}
