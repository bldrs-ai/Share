{
  "description": "If the corrective write keeps failing through its inline retries, answer 500 so Stripe redelivers; the redelivery re-derives entitlement from Stripe and demotes then.",
  "env": {
    "$fixture": "env/stripe.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/stripe-webhook",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "user-agent": "Stripe/1.0 (+https://stripe.com/docs/webhooks)"
    },
    "sign": "stripe",
    "body": {
      "$fixture": "stripe/event.subscription.created.json"
    }
  },
  "exchanges": [
    {
      "$fixture": "exchanges/auth0-mgmt-token.json"
    },
    {
      "$fixture": "exchanges/auth0-search-by-customer-none.json"
    },
    {
      "$fixture": "exchanges/stripe-customer.json"
    },
    {
      "$fixture": "exchanges/auth0-users-by-email.json"
    },
    {
      "$fixture": "exchanges/stripe-subscriptions-pro-active.json"
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        },
        "body": {
          "app_metadata": {
            "subscriptionStatus": "shareProPendingReauth",
            "stripeCustomerId": "cus_Rreplay0001"
          }
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json",
          "$merge": {
            "app_metadata": {
              "subscriptionStatus": "shareProPendingReauth",
              "stripeCustomerId": "cus_Rreplay0001"
            }
          }
        }
      }
    },
    {
      "$fixture": "exchanges/stripe-subscriptions-pro-canceled.json"
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        },
        "body": {
          "app_metadata": {
            "subscriptionStatus": "freePendingReauth",
            "stripeCustomerId": "cus_Rreplay0001"
          }
        }
      },
      "response": {
        "status": 503,
        "json": {
          "statusCode": 503,
          "error": "Service Unavailable",
          "message": "Auth0 is unavailable"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        },
        "body": {
          "app_metadata": {
            "subscriptionStatus": "freePendingReauth",
            "stripeCustomerId": "cus_Rreplay0001"
          }
        }
      },
      "response": {
        "status": 503,
        "json": {
          "statusCode": 503,
          "error": "Service Unavailable",
          "message": "Auth0 is unavailable"
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        },
        "body": {
          "app_metadata": {
            "subscriptionStatus": "freePendingReauth",
            "stripeCustomerId": "cus_Rreplay0001"
          }
        }
      },
      "response": {
        "status": 503,
        "json": {
          "statusCode": 503,
          "error": "Service Unavailable",
          "message": "Auth0 is unavailable"
        }
      }
    }
  ],
  "expect": {
    "statusCode": 500,
    "bodyIncludes": "Stripe will retry"
  }
}
