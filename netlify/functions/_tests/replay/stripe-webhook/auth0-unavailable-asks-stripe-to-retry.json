{
  "description": "An Auth0 outage before anything is written is transient: answer 500 so Stripe redelivers.",
  "env": {
    "$fixture": "env/stripe.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/stripe-webhook",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "user-agent": "Stripe/1.0 (+https://stripe.com/docs/webhooks)"
    },
    "sign": "stripe",
    "body": {
      "$fixture": "stripe/event.subscription.deleted.json"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://bldrs-replay.us.auth0.com/oauth/token"
      },
      "response": {
        "status": 503,
        "json": {
          "error": "temporarily_unavailable",
          "error_description": "Service Unavailable"
        }
      }
    }
  ],
  "expect": {
    "statusCode": 500,
    "bodyIncludes": "Stripe will retry"
  }
}
