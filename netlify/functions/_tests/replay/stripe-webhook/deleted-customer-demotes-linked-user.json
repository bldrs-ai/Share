{
  "description": "A deleted Stripe customer has no email left, but its user is found by the linked stripeCustomerId, so the cancellation still demotes them (the email-only lookup acknowledged it and left them Pro).",
  "env": {
    "$fixture": "env/stripe.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/stripe-webhook",
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "user-agent": "Stripe/1.0 (+https://stripe.com/docs/webhooks)"
    },
    "sign": "stripe",
    "body": {
      "$fixture": "stripe/event.subscription.deleted.json"
    }
  },
  "exchanges": [
    {
      "$fixture": "exchanges/auth0-mgmt-token.json"
    },
    {
      "$fixture": "exchanges/auth0-search-by-customer-pro.json"
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json",
          "$merge": {
            "app_metadata": {
              "subscriptionStatus": "sharePro",
              "stripeCustomerId": "cus_Rreplay0001"
            }
          }
        }
      }
    },
    {
      "$fixture": "exchanges/stripe-subscriptions-pro-canceled.json",
      "$merge": {
        "response": {
          "json": {
            "data": []
          }
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        },
        "body": {
          "app_metadata": {
            "subscriptionStatus": "freePendingReauth"
          }
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "headers": {
          "authorization": "Bearer mgmt-token-replay"
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json",
          "$merge": {
            "app_metadata": {
              "subscriptionStatus": "freePendingReauth",
              "stripeCustomerId": "cus_Rreplay0001"
            }
          }
        }
      }
    },
    {
      "$fixture": "exchanges/stripe-subscriptions-pro-canceled.json",
      "$merge": {
        "response": {
          "json": {
            "data": []
          }
        }
      }
    }
  ],
  "expect": {
    "statusCode": 200,
    "bodyIncludes": "Success"
  }
}
