{
  "description": "A per-account lookup on a deploy without ACCOUNT_USAGE_KEY_SECRET can't name the account: 500 not configured, before the store is touched.",
  "env": {
    "NODE_ENV": "test",
    "ADMIN_STATS_SECRET": "rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr"
  },
  "request": {
    "method": "GET",
    "path": "/.netlify/functions/account-usage-stats",
    "headers": {
      "authorization": "Bearer rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr"
    },
    "query": {
      "sub": "google-oauth2|1"
    }
  },
  "exchanges": [],
  "expect": {
    "statusCode": 500,
    "json": {
      "error": {
        "code": "account_usage_not_configured"
      }
    }
  }
}
