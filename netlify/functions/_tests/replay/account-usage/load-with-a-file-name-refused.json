{
  "description": "A load report carrying anything outside the enums and metrics (here a file name) is refused 400 before auth: nothing identifying can be stored.",
  "env": {
    "$fixture": "env/account-usage.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/account-usage",
    "headers": {
      "authorization": "Bearer user-access-token",
      "content-type": "application/json",
      "origin": "https://bldrs.ai"
    },
    "body": {
      "kind": "load",
      "report": {
        "$fixture": "account-usage/load-report.json",
        "$merge": {
          "file_name": "tower.ifc"
        }
      }
    }
  },
  "exchanges": [],
  "expect": {
    "statusCode": 400,
    "json": {
      "error": "invalid_account_usage"
    }
  }
}
