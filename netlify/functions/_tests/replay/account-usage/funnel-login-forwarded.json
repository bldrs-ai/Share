{
  "description": "A login started from a gate is forwarded to GA under the fixed client id with source: server, whatever the opt-out says (nothing is stored, and GA gets no account): no store read at all.",
  "env": {
    "$fixture": "env/account-usage.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/account-usage",
    "headers": {
      "authorization": "Bearer user-access-token",
      "content-type": "application/json",
      "origin": "https://bldrs.ai"
    },
    "body": {
      "kind": "funnel",
      "event": "login",
      "params": {
        "method": "google",
        "from": "gate",
        "feature": "export"
      }
    }
  },
  "exchanges": [
    {
      "$fixture": "exchanges/auth0-userinfo.json"
    },
    {
      "request": {
        "method": "POST",
        "url": "https://www.google-analytics.com/mp/collect?measurement_id=G-REPLAY0001&api_secret=mp-secret-replay",
        "bodyJson": {
          "client_id": "188986569.3581900407",
          "events": [
            {
              "name": "login",
              "params": {
                "method": "google",
                "from": "gate",
                "feature": "export",
                "source": "server"
              }
            }
          ]
        }
      },
      "response": {
        "status": 204
      }
    }
  ],
  "expect": {
    "statusCode": 204
  }
}
