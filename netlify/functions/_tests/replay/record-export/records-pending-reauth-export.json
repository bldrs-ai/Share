{
  "description": "shareProPendingReauth records like sharePro: the entry is prepended with the client's id, no charge needed.",
  "env": {
    "$fixture": "env/auth0.json"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/record-export",
    "headers": {
      "authorization": "Bearer user-access-token"
    },
    "body": {
      "id": "0d4e2c1a-7b3f-4c5d-8e9f-1a2b3c4d5e6f",
      "key": "/share/v/p/index.ifc",
      "format": "glb",
      "bytes": 4096
    }
  },
  "exchanges": [
    {
      "$fixture": "exchanges/auth0-userinfo.json"
    },
    {
      "$fixture": "exchanges/auth0-mgmt-token.json"
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347"
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json",
          "$merge": {
            "app_metadata": {
              "subscriptionStatus": "shareProPendingReauth"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "body": {
          "app_metadata": {
            "exports": [
              {
                "id": "0d4e2c1a-7b3f-4c5d-8e9f-1a2b3c4d5e6f",
                "key": "/share/v/p/index.ifc",
                "bytes": 4096
              }
            ]
          }
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json"
        }
      }
    }
  ],
  "expect": {
    "statusCode": 200,
    "json": {
      "exports": [
        {
          "id": "0d4e2c1a-7b3f-4c5d-8e9f-1a2b3c4d5e6f",
          "bytes": 4096
        }
      ]
    }
  }
}
