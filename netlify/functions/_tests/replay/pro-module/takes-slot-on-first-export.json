{
  "description": "A free user's first export of a local file (free to view, holding no slot) takes one of the two model slots: the key is appended to app_metadata.usageQuota.loads — record-load's ledger, rolled-off rows dropped — BEFORE the module goes out, and the slots after the delivery ride in X-Bldrs-Model-Slots. The retired free-export rows are neither read nor written. Fields beside `loads` in usageQuota are written back, since Auth0 replaces a top-level key whole.",
  "env": {
    "$fixture": "env/auth0.json",
    "$merge": {
      "LAMBDA_TASK_ROOT": {
        "$fixturePath": "task-root"
      }
    }
  },
  "now": "2026-10-27T12:00:00.000Z",
  "request": {
    "method": "GET",
    "path": "/.netlify/functions/pro-module",
    "headers": {
      "authorization": "Bearer user-access-token",
      "x-bldrs-model-key": "%2Fshare%2Fv%2Flocal-only%2F0b9f4c2e-7d1a-4c55-9f0e-3a1b2c3d4e5f.ifc"
    },
    "query": {
      "name": "glbExport"
    }
  },
  "exchanges": [
    {
      "$fixture": "exchanges/auth0-userinfo.json"
    },
    {
      "$fixture": "exchanges/auth0-mgmt-token.json"
    },
    {
      "request": {
        "method": "GET",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347"
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json",
          "$merge": {
            "app_metadata": {
              "exports": [
                {
                  "id": "a3f1c2d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
                  "key": "/share/v/p/index.ifc",
                  "title": "index.ifc",
                  "format": "glb",
                  "bytes": 1024,
                  "exportedAt": "2026-10-26T08:00:00.000Z",
                  "free": true
                },
                {
                  "id": "b4a2d3e5-6f7a-4b8c-9d0e-1f2a3b4c5d6e",
                  "key": "/share/v/p/index.ifc",
                  "title": "index.ifc",
                  "format": "glb",
                  "bytes": 1024,
                  "exportedAt": "2026-10-25T09:00:00.000Z",
                  "free": true
                }
              ],
              "usageQuota": {
                "loads": [
                  {
                    "key": "/share/v/g/1AbCdEfGhIjKlMnOpQrStUvWxYz",
                    "loadedAt": "2026-10-25T10:00:00.000Z"
                  },
                  {
                    "key": "/share/v/gh/acme/private/main/tower.ifc",
                    "loadedAt": "2026-10-18T10:00:00.000Z"
                  }
                ],
                "note": "kept"
              }
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://bldrs-replay.us.auth0.com/api/v2/users/google-oauth2%7C103547991597142817347",
        "body": {
          "app_metadata": {
            "usageQuota": {
              "loads": [
                {
                  "key": "/share/v/g/1AbCdEfGhIjKlMnOpQrStUvWxYz",
                  "loadedAt": "2026-10-25T10:00:00.000Z"
                },
                {
                  "key": "/share/v/local-only/0b9f4c2e-7d1a-4c55-9f0e-3a1b2c3d4e5f.ifc",
                  "loadedAt": "2026-10-27T12:00:00.000Z",
                  "via": "export"
                }
              ],
              "note": "kept"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "json": {
          "$fixture": "auth0/user.json"
        }
      }
    }
  ],
  "expect": {
    "statusCode": 200,
    "bodyIncludes": "replayStandIn",
    "headers": {
      "content-type": "text/javascript; charset=utf-8",
      "cache-control": "private, no-store",
      "x-bldrs-model-slots": "{\"limit\":2,\"used\":2,\"remaining\":0,\"nextFreeAt\":\"2026-11-01T10:00:00.000Z\",\"taken\":true,\"public\":false}"
    }
  }
