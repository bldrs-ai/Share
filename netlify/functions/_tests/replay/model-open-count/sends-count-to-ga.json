{
  "description": "A displayed load's report from Share's origin goes to the Measurement Protocol under the one fixed client id, with exactly its fields (session_id is GA's own session param), and the page gets 204.",
  "env": {
    "GA4_MEASUREMENT_ID": "G-REPLAY0001",
    "GA4_API_SECRET": "mp-secret-replay"
  },
  "request": {
    "method": "POST",
    "path": "/.netlify/functions/model-open-count",
    "headers": {
      "origin": "https://bldrs.ai",
      "content-type": "text/plain;charset=UTF-8"
    },
    "body": "{\"content_type\":\"ifc\",\"size_bucket\":\"10-50mb\",\"source\":\"github\",\"sample_id\":\"none\",\"open_kind\":\"page\",\"form_factor\":\"desktop\",\"load_outcome\":\"displayed\",\"reason_class\":\"none\",\"last_phase\":\"none\",\"session_id\":\"4503599627370497\",\"load_ms\":8123,\"first_mesh_ms\":2100,\"triangle_count\":1234567,\"error_count\":0,\"warning_count\":12}"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.google-analytics.com/mp/collect?measurement_id=G-REPLAY0001&api_secret=mp-secret-replay",
        "body": {
          "client_id": "3587090903.711617492",
          "events": [
            {
              "name": "model_open_count",
              "params": {
                "content_type": "ifc",
                "size_bucket": "10-50mb",
                "source": "github",
                "sample_id": "none",
                "open_kind": "page",
                "form_factor": "desktop",
                "load_outcome": "displayed",
                "reason_class": "none",
                "last_phase": "none",
                "session_id": "4503599627370497",
                "load_ms": 8123,
                "first_mesh_ms": 2100,
                "triangle_count": 1234567,
                "error_count": 0,
                "warning_count": 12
              }
            }
          ]
        }
      },
      "response": {
        "status": 204,
        "text": ""
      }
    }
  ],
  "expect": {
    "statusCode": 204
  }
}
